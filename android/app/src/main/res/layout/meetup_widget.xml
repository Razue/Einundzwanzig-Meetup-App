<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Kopfzeile: BITCOIN-Label + großer Blockwert -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BITCOIN"
            android:textColor="#F7931A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLOCK"
            android:textColor="#5A5F68"
            android:textSize="9sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widget_block"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="––"
            android:textColor="#F7931A"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Trennlinie (FrameLayout statt View: RemoteViews erlaubt kein nacktes View!) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22F7931A"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp" />

    <!-- Kennzahlen-Zeile: Preis | Moscow | Fees -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREIS"
                android:textColor="#5A5F68"
                android:textSize="9sp"
                android:layout_marginBottom="3dp" />
            <TextView
                android:id="@+id/widget_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–– €"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOSCOW"
                android:textColor="#5A5F68"
                android:textSize="9sp"
                android:layout_marginBottom="3dp" />
            <TextView
                android:id="@+id/widget_moscow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––:––"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEES L·M·H"
                android:textColor="#5A5F68"
                android:textSize="9sp"
                android:layout_marginBottom="3dp" />
            <TextView
                android:id="@+id/widget_fees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–·–·–"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nächstes Meetup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_meetup_bg"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÄCHSTES MEETUP"
                android:textColor="#F7931A"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />
            <TextView
                android:id="@+id/widget_meetup_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_meetup_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="––"
            android:textColor="#F7931A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

</LinearLayout>
