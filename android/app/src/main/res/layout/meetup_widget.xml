<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <!-- Kopf: Logo links (klickbar -> App), Refresh-Rädchen rechts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <ImageView
            android:id="@+id/widget_logo"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:src="@drawable/widget_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:contentDescription="Einundzwanzig" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#8A8F98"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⟳"
            android:textColor="#F7931A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingLeft="14dp"
            android:paddingRight="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- BEREICH BITCOIN (klickbar -> Bitcoin-Ansicht) -->
    <LinearLayout
        android:id="@+id/widget_btc_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Kopfzeile: BITCOIN-Label + großer Blockwert -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BITCOIN"
                android:textColor="#F7931A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLOCK"
                android:textColor="#8A8F98"
                android:textSize="9sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/widget_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––"
                android:textColor="#F7931A"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Trennlinie -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22F7931A"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp" />

        <!-- Kennzahlen-Zeile: Preis | Moscow | Fees -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PREIS"
                    android:textColor="#8A8F98"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp" />
                <TextView
                    android:id="@+id/widget_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–– €"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOSCOW"
                    android:textColor="#8A8F98"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp" />
                <TextView
                    android:id="@+id/widget_moscow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="––:––"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FEES L·M·H"
                    android:textColor="#8A8F98"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp" />
                <TextView
                    android:id="@+id/widget_fees"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="–·–·–"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Zweite Kennzahlen-Zeile: Hashrate | Supply | Difficulty -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HASHRATE"
                    android:textColor="#8A8F98"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp" />
                <TextView
                    android:id="@+id/widget_hashrate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="––"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUPPLY"
                    android:textColor="#8A8F98"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp" />
                <TextView
                    android:id="@+id/widget_supply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="––"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIFFICULTY"
                    android:textColor="#8A8F98"
                    android:textSize="9sp"
                    android:layout_marginBottom="3dp" />
                <TextView
                    android:id="@+id/widget_difficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="––"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- BEREICH MEETUP (klickbar -> Event) -->
    <LinearLayout
        android:id="@+id/widget_meetup_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_meetup_bg"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÄCHSTES MEETUP"
                android:textColor="#F7931A"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />
            <TextView
                android:id="@+id/widget_meetup_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="––"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_meetup_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="––"
            android:textColor="#F7931A"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <!-- BEREICH NEWS (klickbar -> Artikel) -->
    <LinearLayout
        android:id="@+id/widget_news_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEWS"
            android:textColor="#F7931A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/widget_news_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEU"
            android:textColor="#141416"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/widget_new_badge"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_news_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="––"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#8A8F98"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
